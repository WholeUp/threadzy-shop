{
  "crons": [
    {
      "path": "/api/cron-morning-alert?time=0900",
      "schedule": "30 3 * * 1-5"
    },
    {
      "path": "/api/cron-morning-alert?time=0915",
      "schedule": "45 3 * * 1-5"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
